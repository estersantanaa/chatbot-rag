# Obrigatório — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# SQLite do histórico de chat
DATABASE_URL=sqlite:///./chatbot.db

# Pasta gerada por test_ingest.py ou src.services.ingestion (FAISS)
VECTOR_DB_PATH=vector_db

# Documentos .txt e .pdf para ingestão
DOCUMENTS_PATH=data

# Trechos recuperados por pergunta (similarity_search)
RAG_TOP_K=4

# Mensagens anteriores enviadas ao LLM por requisição
CHAT_HISTORY_LIMIT=10

DEBUG=True

# Modelo HuggingFace (baixado na 1ª ingestão se não houver cache)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Caminho local do modelo (evita download). Ex.: models/all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=
# true = só usa cache/pasta local (não tenta baixar)
EMBEDDING_LOCAL_ONLY=false
